---
// Progressive blur along the bottom edge of the screen (like midu.design):
// 8 steps, each blurring twice as much as the one before, each masked to its own
// band, so the blur fades in smoothly toward the bottom edge.
// Performance: every layer is only as tall as its band (a backdrop blur costs by
// area, and it is redrawn on every frame something moves under it), and the two
// top steps (under 1px of blur, invisible) are skipped.
const LAYERS = 8;
const MAX_BLUR = 36; // px, the bottom-most layer (midu.design uses 17.5)
const MIN_BLUR = 1; // px, lighter steps are not drawn
const step = 100 / LAYERS; // band, % of the strip
const layers = Array.from({ length: LAYERS }, (_, i) => {
  const blur = +(MAX_BLUR / 2 ** (LAYERS - 1 - i)).toFixed(3);
  const top = i * step;
  const bottom = Math.min((i + 3) * step, 100);
  const h = bottom - top;
  const at = (p: number) => `${(((p - top) / h) * 100).toFixed(2)}%`;
  // fade in over one band, full over the next, fade out over the third (cut at the bottom edge)
  const mask = `linear-gradient(to bottom, transparent 0%, #000 ${at(top + step)}, #000 ${at(Math.min(top + 2 * step, 100))}, ${(i + 3) * step > 100 ? '#000' : 'transparent'} 100%)`;
  return { blur, top, h, mask };
}).filter((l) => l.blur >= MIN_BLUR);
---

<div class="progressive-blur" aria-hidden="true">
  {layers.map((l, i) => (
    <div style={`top: ${l.top}%; height: ${l.h}%; z-index: ${i + 1}; backdrop-filter: blur(${l.blur}px); -webkit-backdrop-filter: blur(${l.blur}px); mask-image: ${l.mask}; -webkit-mask-image: ${l.mask}`} />
  ))}
</div>

<style>
  .progressive-blur {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 107px; /* 160 − ⅓ */
    z-index: 50; /* above the page, below the navbar (100) */
    pointer-events: none;
  }
  /* Faded per layer: opacity on the strip itself would cut the layers off from the page behind */
  .progressive-blur > div {
    opacity: var(--blur-opacity, 1);
    position: absolute;
    left: 0;
    right: 0;
  }
</style>

<script>
  // Over the footer the blur goes away: it fades out as the page plate's bottom edge
  // rises through the strip, and comes back when the plate covers it again.
  const strip = document.querySelector<HTMLElement>('.progressive-blur');
  const plate = document.querySelector<HTMLElement>('main.page');
  if (strip && plate) {
    let queued = false;
    const update = () => {
      queued = false;
      const h = strip.offsetHeight;
      const covered = plate.getBoundingClientRect().bottom - (innerHeight - h); // px of the strip over the plate
      const o = Math.min(Math.max(covered / h, 0), 1);
      strip.style.setProperty('--blur-opacity', o.toFixed(3));
      strip.style.visibility = o === 0 ? 'hidden' : '';
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
