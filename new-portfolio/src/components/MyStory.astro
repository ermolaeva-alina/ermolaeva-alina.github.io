---
// Figma: "My story" 553:617992 — a 20 × 23 tile grid with story cards,
// dot-matrix screens (inline SVG, ready for animation) and icon tiles.
import Chip from './Chip.astro';
import DotScreen from './DotScreen.astro';
import InlineSvg from './InlineSvg.astro';
import { heart, eyes, glass } from '../data/dot-screens';
import iconEight from '../assets/story/icon-eight.svg?raw';
import iconType from '../assets/story/icon-type.svg?raw';
import iconAsterisk from '../assets/story/icon-asterisk.svg?raw';
import iconPlay from '../assets/story/icon-play.svg?raw';

// Grid placement from Figma (0-based row/col + spans)
type Area = { r: number; c: number; rs?: number; cs?: number };
const place = ({ r, c, rs = 1, cs = 1 }: Area) => `grid-area: ${r + 1} / ${c + 1} / span ${rs} / span ${cs}`;

// Tiles exist only in these cells (row * 100 + col), exactly as in Figma
const tileCells = '7,9,11,12,14,15,16,17,18,19,108,109,112,113,114,115,116,118,119,209,212,213,214,215,216,217,218,219,309,310,319,400,409,410,418,419,501,502,504,505,507,508,509,510,518,519,602,603,604,605,606,608,609,610,618,619,702,703,704,706,707,708,709,710,718,719,800,801,810,818,819,900,919,1000,1001,1010,1018,1019,1101,1110,1111,1112,1113,1114,1115,1116,1118,1119,1200,1210,1211,1212,1213,1214,1219,1300,1301,1310,1312,1313,1314,1319,1400,1401,1410,1411,1412,1413,1414,1419,1500,1501,1511,1512,1513,1514,1519,1600,1601,1610,1612,1613,1619,1700,1701,1702,1703,1704,1705,1706,1707,1708,1710,1711,1712,1713,1714,1719,1800,1812,1814,1819,1900,1912,1913,1914,1919,2000,2013,2014,2015,2016,2019,2100,2112,2113,2114,2115,2116,2117,2118,2119,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2213,2214,2215,2216,2217,2219'
  .split(',')
  .map(Number)
  .map((n) => ({ r: Math.floor(n / 100), c: n % 100 }));

// Photos in "Outside of work" (Figma "Bounding Box" instances): x/y is the frame's
// top-left corner before rotation, rot is Figma's angle (counter-clockwise).
// The photo is a plain image; the orange frame, corner handles and shadow are CSS,
// so nothing gets cut off at the image edges.
const photos = [
  { src: '/images/story/photo-1.webp', x: -30, y: 2.4, w: 199.27, h: 200.32, rot: 9.999, alt: 'A street in an old town' },
  { src: '/images/story/photo-2.webp', x: 134.2, y: -23.52, w: 211.58, h: 183.08, rot: -6.335, alt: 'Alina by the sea' },
  { src: '/images/story/photo-3.webp', x: 29.18, y: 17.9, w: 221.34, h: 184.36, rot: 4.022, alt: 'Alina hiking in the mountains' },
];
---

<section class="story" id="about" aria-labelledby="story-title">
  <div class="side cell--hatch"></div>

  <div class="grid">
    {tileCells.map((t) => <div class="tile" style={place(t)} aria-hidden="true" />)}

    <InlineSvg svg={iconAsterisk} id="icon-asterisk" class="icon" style={place({ r: 6, c: 7 })} />

    <header class="head" style={place({ r: 1, c: 1, rs: 4, cs: 7 })}>
      <Chip>About</Chip>
      <h2 class="head__title" id="story-title">
        Design is where <span class="raster">structure</span> has to <span class="raster">make sense</span> to a <span class="raster">human.</span>
      </h2>
    </header>

    <article class="card card--eyes" style={place({ r: 3, c: 11, rs: 8, cs: 7 })}>
      <DotScreen screen={eyes} id="screen-eyes" label="Two pixel eyes" />
      <div class="card__text">
        <h3 class="card__title">What I actually <span class="raster-r">do</span></h3>
        <p class="t-body-16">
          Most of the work is deciding what the thing actually is. I take half-defined problems — a business goal, some constraints, a rough sense of user needs — and turn them into a structure that holds. I work close to product, so I'm part of deciding what we build and what it moves for the business, and I stay through build, where the real decisions happen.
        </p>
      </div>
    </article>

    <InlineSvg svg={iconType} id="icon-type" class="icon icon--lg" style={place({ r: 6, c: 0, rs: 2, cs: 2 })} />

    <article class="card card--heart" style={place({ r: 8, c: 2, rs: 9, cs: 8 })}>
      <DotScreen screen={heart} id="screen-heart" label="Pixel heart" inset={false} />
      <div class="card__text card__text--24">
        <h3 class="card__title">I like <span class="raster-r">design that</span> has to <span class="raster-r">work</span></h3>
        <p class="t-body-16">
          The part I enjoy most is the moment a solution finally lines up — when the structure, the interface, and how it feels to use all agree, and it stops feeling like a compromise. Getting there means research and known patterns, and it means caring how someone feels using the thing, not only whether they can. And the products I work on are tools people build their own things with, which is a good reason to get them right.
        </p>
      </div>
    </article>

    <article class="card card--glass" style={place({ r: 18, c: 1, rs: 4, cs: 11 })}>
      <DotScreen screen={glass} id="screen-glass" label="Pixel cocktail glass" />
      <div class="card__text card__text--wide">
        <h3 class="card__title">Where the <span class="raster-r">background</span> comes in</h3>
        <p class="t-body-16">
          A Bachelor's at a technical university — advanced math, statistics, coding in several languages — gave me a structural way of thinking. A Master's in HCI and UX Design added the other half: user psychology, quantitative research, accessibility. One taught me how systems hold together, the other how people actually meet them.
        </p>
      </div>
    </article>

    <InlineSvg svg={iconEight} id="icon-eight" class="icon icon--lg" style={place({ r: 1, c: 10, rs: 2, cs: 2 })} />

    <article class="card card--photos" style={place({ r: 12, c: 15, rs: 8, cs: 4 })}>
      {photos.map((p) => (
        <figure
          class="photo"
          style={`left: ${p.x}px; top: ${p.y}px; width: ${p.w}px; height: ${p.h}px; transform: rotate(${-p.rot}deg)`}
        >
          <img src={p.src} width={Math.round(p.w)} height={Math.round(p.h)} alt={p.alt} loading="lazy" />
          <span class="photo__handle photo__handle--tl" aria-hidden="true"></span>
          <span class="photo__handle photo__handle--tr" aria-hidden="true"></span>
          <span class="photo__handle photo__handle--bl" aria-hidden="true"></span>
          <span class="photo__handle photo__handle--br" aria-hidden="true"></span>
        </figure>
      ))}
      <div class="card__text card__text--photos">
        <h3 class="card__title"><span class="raster-r">Outside</span> of work</h3>
        <p class="t-body-16">
          I live in Prague with my husband, in the city of my heart. Fourteen countries so far and nowhere near done. Design has been my thing since I was a kid, back when I had no idea it could be a job. I take a lot of photos too — the kind where something looks like a still from a film and I have to show someone right away, except it's just a Tuesday.<br />And music, always.
        </p>
      </div>
    </article>

    <InlineSvg svg={iconPlay} id="icon-play" class="icon" style={place({ r: 16, c: 11 })} />
  </div>

  <div class="side cell--hatch"></div>
</section>

<style>
  .story {
    position: relative;
    display: flex;
    justify-content: center;
    height: 1348px;
  }

  .story::before,
  .story::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-dash-x);
    z-index: 2;
    pointer-events: none;
  }
  .story::before { top: 0; }
  .story::after { bottom: 0; }

  .side {
    flex: 1 1 0;
  }

  .grid {
    width: var(--content-width);
    padding: var(--space-16);
    display: grid;
    grid-template-columns: repeat(20, 56px);
    grid-template-rows: repeat(23, 56px);
    gap: 2px;
  }

  .tile {
    border-radius: var(--radius-s);
    background: rgb(252 253 253 / 0.8); /* Bg light at 80% */
  }

  .icon {
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-xs);
  }
  .icon--lg {
    border-radius: var(--radius-m);
  }

  .raster {
    font-family: var(--font-raster);
    font-weight: 400;
  }
  .raster-r {
    font-family: var(--font-raster-rounded);
    font-weight: 400;
    line-height: 1; /* FK Raster's taller ascent would otherwise grow the 36px line box */
  }

  /* Header */
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }
  .head__title {
    width: 402px;
    font: 600 40px/44px var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-black);
  }

  /* Cards */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--space-24);
    border-radius: 32px;
    background: var(--gradient-surface);
    outline: 1px solid var(--color-border);
    box-shadow: var(--shadow-xs);
    color: var(--color-black);
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .card__text--24 {
    gap: var(--space-24);
  }

  .card__title {
    position: relative;
    top: 1px; /* Figma draws mixed Inter + FK Raster lines 1px lower than Chrome */
    font: 500 32px/36px var(--font-sans); /* Inter tight 32 + FK Raster 32 */
    letter-spacing: -0.02em;
  }

  .card--heart {
    justify-self: end;
    width: 462px;
  }

  .card--glass {
    flex-direction: row;
    gap: var(--space-32);
    justify-self: end;
    width: 636px;
  }
  .card__text--wide {
    width: 450px;
  }

  .card--photos {
    justify-self: end;
    align-self: start;
    width: 348px;
    height: 518px;
    justify-content: flex-end;
    gap: var(--space-32);
  }
  .card__text--photos {
    width: 301px; /* Figma 300: Chrome needs 0.4px more for "…photos too" to stay on its line */
  }
  .photo {
    position: absolute;
    margin: 0;
    transform-origin: 0 0;
    /* Figma: two drop shadows on the "Bounding Box" instance */
    box-shadow:
      0 1.69px 2.535px -0.845px rgb(10 13 18 / 0.03),
      0 5.07px 6.76px -1.69px rgb(10 13 18 / 0.08);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* Selection frame: 0.975px stroke centered on the edge */
  .photo::after {
    content: '';
    position: absolute;
    inset: -0.4875px;
    border: 0.975px solid var(--color-brand);
    pointer-events: none;
  }
  .photo__handle {
    position: absolute;
    z-index: 1;
    width: 7.8px;
    height: 7.8px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 0.975px var(--color-brand);
  }
  .photo__handle--tl { left: -3.9px; top: -3.9px; }
  .photo__handle--tr { right: -3.9px; top: -3.9px; }
  .photo__handle--bl { left: -3.9px; bottom: -3.9px; }
  .photo__handle--br { right: -3.9px; bottom: -3.9px; }
</style>
