---
// Figma: "Content" 553:660058 — contacts block below the main page frame.
// Floating screenshot cards around a "Let's connect" headline with a screen-blended glow.
// The cards are an endless canvas (like simonrico.com): the Figma set is one tile,
// repeated in a 3 × 3 grid and wrapped, so it can be panned forever in any direction.
// Drag, horizontal trackpad scroll, or scrolling down at the page bottom pans it;
// page scroll adds a parallax drift. The headline group stays in the middle, under the cards.
import Chip from './Chip.astro';
import Button from './Button.astro';
import InlineSvg from './InlineSvg.astro';
import linkedin from '../assets/contacts/linkedin.svg?raw';
import behance from '../assets/contacts/behance.svg?raw';
import copy from '../assets/contacts/copy.svg?raw'; // Figma: email button "Group 23"

const EMAIL = 'alinaermolaeva044@gmail.com';

const links = {
  linkedin: 'https://www.linkedin.com/in/alina-ermolaeva-/',
  behance: 'https://www.behance.net/mandxalinka',
  cv: '#', // TODO: CV link
};

const TILE_W = 1996; // Figma: the off-canvas copies sit 1996px to the left
const TILE_H = 1000;
const TILES = [-1, 0, 1].flatMap((r) => [-1, 0, 1].map((c) => ({ r, c })));

// Card frames relative to the section (Figma "Container" 718:558613)
const cards = [
  { src: '/images/contacts/card-1.webp', x: 1392, y: 58, w: 230, h: 288 },
  { src: '/images/contacts/card-2.webp', x: 174, y: 58, w: 288, h: 346 },
  { src: '/images/contacts/card-3.webp', x: 1508, y: 638, w: 288, h: 230 },
  { src: '/images/contacts/card-4.webp', x: 348, y: 522, w: 346, h: 288 },
  { src: '/images/contacts/card-5.webp', x: 986, y: 638, w: 145, h: 145 },
  { src: '/images/contacts/card-6.webp', x: 560.07, y: 44.5, w: 145, h: 145 },
];
---

<section class="contacts" id="contacts" aria-labelledby="contacts-title">
  <div class="contacts__texture" aria-hidden="true"></div>

  <div class="contacts__cards" aria-hidden="true">
    <div class="contacts__track" data-tile-w={TILE_W} data-tile-h={TILE_H}>
    {TILES.flatMap((t) => cards.map((c) => (
      <img
        class="card"
        src={c.src}
        width={c.w}
        height={c.h}
        alt=""
        loading="lazy"
        style={`left: ${c.x + t.c * TILE_W}px; top: ${c.y + t.r * TILE_H}px; width: ${c.w}px; height: ${c.h}px`}
      />
    )))}
    </div>
  </div>

  <div class="contacts__center">
    <Chip point="green" weight={500}>Contacts</Chip>

    <div class="headline">
      <h2 class="headline__text" id="contacts-title">Let’s connect :)</h2>
      <img class="headline__glow" src="/images/contacts/glow.webp" width="813" height="234" alt="" aria-hidden="true" />
    </div>

    <div class="methods">
      <Button href={links.linkedin} color="black" size={44} iconOnly label="LinkedIn">
        <InlineSvg slot="icon" svg={linkedin} id="icon-linkedin" />
      </Button>
      <Button href={links.behance} color="black" size={44} iconOnly label="Behance">
        <InlineSvg slot="icon" svg={behance} id="icon-behance" />
      </Button>
      <Button href={links.cv} color="black" size={44} class="cv">CV</Button>
      <Button color="orange" size={44} class="email" data-email={EMAIL} aria-label={`Copy email ${EMAIL}`}>
        <InlineSvg slot="icon" svg={copy} id="icon-copy" />
        <span class="email__label">{EMAIL}</span>
      </Button>
    </div>
  </div>
</section>

<script>
  // Endless card canvas. Drag/wheel pan eases toward its target; the scroll parallax
  // follows the scroll 1:1 (easing it made the cards lag and jitter behind the page).
  // While the page plate still covers the footer, nothing is drawn.
  const PARALLAX = 0.5; // extra drift per px of page scroll
  const EASE = 0.12;
  const initCards = () => {
    const section = document.querySelector<HTMLElement>('.contacts');
    const track = section?.querySelector<HTMLElement>('.contacts__track');
    if (!section || !track || track.dataset.ready) return;
    track.dataset.ready = '1';
    const W = +track.dataset.tileW!, H = +track.dataset.tileH!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pan = { x: 0, y: 0 }; // from drag and wheel
    const cur = { x: 0, y: 0 }; // what is drawn
    const maxScroll = () => document.documentElement.scrollHeight - innerHeight;
    const parallax = () => (still ? 0 : (maxScroll() - scrollY) * PARALLAX);
    const plate = document.querySelector<HTMLElement>('main.page');
    const covered = () => !!plate && plate.getBoundingClientRect().bottom >= innerHeight;
    const wrap = (v: number, p: number) => ((v % p) + p) % p;
    let raf = 0;
    const draw = () => {
      raf = 0;
      const k = still ? 1 : EASE;
      cur.x += (pan.x - cur.x) * k;
      cur.y += (pan.y - cur.y) * k;
      if (Math.abs(pan.x - cur.x) < 0.1 && Math.abs(pan.y - cur.y) < 0.1) { cur.x = pan.x; cur.y = pan.y; }
      else raf = requestAnimationFrame(draw);
      if (covered()) return;
      const x = Math.round(wrap(cur.x, W) * 2) / 2, y = Math.round(wrap(cur.y + parallax(), H) * 2) / 2;
      track.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(draw); };
    draw();

    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', kick);
    section.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) pan.x -= e.deltaX;
      else if (e.deltaY > 0 && scrollY >= maxScroll() - 1) pan.y -= e.deltaY; // past the page end
      else return; // normal page scroll
      e.preventDefault();
      kick();
    }, { passive: false });

    let drag: { id: number; x: number; y: number; vx: number; vy: number } | null = null;
    section.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button') || e.button !== 0) return;
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, vx: 0, vy: 0 };
      section.setPointerCapture(e.pointerId);
      section.classList.add('is-dragging');
    });
    section.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      drag = { ...drag, x: e.clientX, y: e.clientY, vx: dx, vy: dy };
      pan.x += dx; pan.y += dy;
      kick();
    });
    const end = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (!still) { pan.x += drag.vx * 12; pan.y += drag.vy * 12; } // flick carries on
      drag = null;
      section.classList.remove('is-dragging');
      kick();
    };
    section.addEventListener('pointerup', end);
    section.addEventListener('pointercancel', end);
  };

  // Copy the email on click; the label reads "E-mail copied. Let’s chat :)" for a moment
  const init = () => {
    document.querySelectorAll<HTMLButtonElement>('.email[data-email]').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      const label = btn.querySelector('.email__label');
      btn.addEventListener('click', async () => {
        const email = btn.dataset.email!;
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          window.location.href = `mailto:${email}`;
          return;
        }
        if (!label) return;
        label.textContent = 'E-mail copied. Let’s chat :)';
        setTimeout(() => (label.textContent = email), 2000);
      });
    });
    initCards();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* Footer reveal: pinned to the bottom of the screen under the page plate, so the
     plate slides up off it instead of the footer scrolling in */
  .contacts {
    position: sticky;
    bottom: 0;
    z-index: 0;
    height: 926px;
    /* Its own surface: z-index isolates it, so the glow's Screen blend needs a
       backdrop inside the section (Figma: Container "Surface gradient") */
    background: var(--gradient-surface);
    overflow-x: clip; /* the 2048px texture is wider than the viewport */
  }

  /* Figma "image 556": the hatch texture at 28%, starting 411.5px above the block */
  .contacts__texture {
    position: absolute;
    left: 0;
    top: -411.5px;
    width: 2048px;
    height: 1337.5px; /* the texture ends here in Figma; the tile stops with the box */
    background: url('/images/hatch.svg') 0 0 / 220px 220px repeat;
    opacity: 0.28;
    pointer-events: none;
  }

  .contacts {
    cursor: grab;
    touch-action: pan-y; /* vertical swipes still scroll the page on touch screens */
  }
  .contacts.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .contacts__cards {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1; /* above "Let's connect" and the buttons */
    pointer-events: none; /* the buttons under the cards stay clickable */
  }
  /* The whole set moves as one compositor layer: no repaint while it moves */
  .contacts__track {
    position: absolute;
    top: 0;
    left: calc(50% - 960px); /* the Figma frame is 1920 wide, centered */
    width: 1920px;
    height: 100%;
    will-change: transform;
  }

  .card {
    position: absolute;
    max-width: none;
    border-radius: var(--radius-card);
  }
  /* Same light shadow as the page plate (Figma: effects/drop-shadow/xs) */
  .card {
    box-shadow: 0 1px 2px rgb(54 54 48 / 0.05);
  }

  .contacts__center {
    position: absolute;
    /* centered without transform: a transform would create a stacking context and
       the glow's Screen blend would mix with nothing instead of the page */
    left: calc(50% - 289px);
    top: 250px;
    width: 578px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .headline {
    position: relative;
    width: 578px;
    height: 114px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .headline__text {
    font: 400 81.55px/110.56px var(--font-raster-rounded);
    letter-spacing: -0.02em;
    color: var(--color-black);
    white-space: nowrap;
    /* Figma: white 13.36px stroke OUTSIDE + two soft shadows */
    -webkit-text-stroke: 26.72px var(--color-white);
    paint-order: stroke fill;
    filter: drop-shadow(0.84px 1.67px 1.67px rgb(54 54 48 / 0.05)) drop-shadow(-1.67px 0 1.25px rgb(54 54 48 / 0.05));
  }

  /* Figma "LIGHT": four blurred ellipses in Screen blend over the text */
  .headline__glow {
    position: absolute;
    left: -123.09px;
    top: -49.57px;
    width: 812.61px;
    height: 233.93px;
    max-width: none;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .methods {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .methods :global(.cv) {
    width: 43px;
    padding: var(--space-16) 7px;
  }
  .methods :global(.cv .btn__text) {
    font-weight: 650; /* optical balance with the solid "in" and "Bē" marks */
  }
  /* Optical balance: the solid LinkedIn "in" reads biggest, Behance smallest */
  .methods :global([data-svg="icon-linkedin"]) {
    width: 15px;
    height: auto;
  }
  .methods :global([data-svg="icon-behance"]) {
    width: 19px;
    height: auto;
  }

  .methods :global(.email) {
    width: 279px;
  }
</style>
