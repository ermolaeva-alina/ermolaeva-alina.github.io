---
// Figma: "Project Card" (component "Case") — cover on the left, text on the right
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
---

<article class="case">
  <img class="case__cover" src={d.cover} width="567" height="544" alt={d.coverAlt} loading="lazy" />

  <div class="case__content">
    <img class="case__icon" src={d.icon} width="44" height="44" alt="" />

    <div class="case__text">
      <h3 class="case__title">
        <span class="case__company" style={`color: ${d.accent}`}>{d.company}</span>
        {' '}{d.title}
      </h3>
      <p class="t-body-16">{d.summary}</p>
    </div>

    <div class="case__footer">
      <p class="case__role t-label-12">{d.role}</p>
      <Button href={`/work/${entry.id}`}>Read case study</Button>
    </div>
  </div>
</article>

<style>
  .case {
    display: grid;
    grid-template-columns: 1fr 1fr; /* two equal FILL columns, padding doesn't skew them */
    gap: var(--space-8);
    height: 560px;
    padding: var(--space-8);
    border-radius: 32px; /* Figma: Project Card */
    background: var(--gradient-surface);
    outline: 1px solid var(--color-border);
    box-shadow: var(--shadow-xs);
  }

  .case__cover {
    width: 100%;
    height: 544px;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-xs);
    object-fit: cover;
  }

  .case__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px var(--space-32) var(--space-32);
  }

  .case__icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }

  .case__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    color: var(--color-black);
  }

  .case__title {
    font: 600 32px/36px var(--font-sans); /* Label 32 */
    letter-spacing: -0.02em;
  }

  .case__company {
    font-family: var(--font-raster-rounded); /* FK Raster 32 */
    font-weight: 400;
  }

  .case__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .case__role {
    width: 240px;
    color: var(--color-gray-light);
  }
</style>
