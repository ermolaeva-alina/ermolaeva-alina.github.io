---
// Dot-matrix screen ("Btn" frames in My story): a black glossy frame around a
// DotMatrix picture (inline SVG, every lit dot animatable — see DotMatrix.astro).
// Hovering replays the picture: the lit dots pop back in random order.
import type { DotScreen } from '../data/dot-screens';
import DotMatrix from './DotMatrix.astro';

interface Props {
  screen: DotScreen;
  id: string; // unique per page — used for SVG pattern/gradient ids
  label: string; // accessible description of the picture
  inset?: boolean; // glossy inner highlights (eyes, glass); the heart has none
  class?: string;
}
const { screen: s, id, label, inset = true, class: className } = Astro.props;
---

<div class:list={['screen', { 'screen--inset': inset }, className]} data-dot-replay>
  <DotMatrix
    id={id}
    label={label}
    rows={s.rows}
    cols={s.cols}
    width={s.width}
    height={s.height}
    pitchX={s.pitchX}
    pitchY={s.pitchY}
    r={2}
    on={s.on}
    empty={s.empty}
    led={s.led}
    shine={{ spread: 2, blur: 6.9, alpha: 0.12 }}
  />
</div>

<style>
  .screen {
    flex: none; /* never shrink inside fixed-height cards */
    display: flex;
    padding: var(--space-8);
    border-radius: var(--radius-card);
    background: #020202; /* Figma: Btn black */
    box-shadow: inset 0 0 0 1px var(--color-black-dark), var(--shadow-dark);
    overflow: hidden;
  }
  .screen--inset {
    box-shadow:
      inset 0 0 0 1px var(--color-black-dark),
      inset 0 -2px 9px rgb(255 255 255 / 0.46),
      inset 0 2px 0 rgb(255 255 255 / 0.28),
      var(--shadow-dark);
  }
</style>
