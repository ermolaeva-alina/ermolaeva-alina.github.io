---
// Figma: "Component 4" — glass pill with a glowing point.
// size "sm": 28px tall, Label 12 (Experienced at); "md": 32px tall, 14px text (section labels)
// weight: section chips differ in Figma — "Case studies"/"About" use 550, "Contacts" 500
interface Props {
  size?: 'sm' | 'md';
  point?: 'orange' | 'green';
  weight?: 500 | 550;
  class?: string;
}
const { size = 'md', point = 'orange', weight = 550, class: className } = Astro.props;
---

<span class:list={['chip', `chip--${size}`, className]} data-glass style={size === 'md' ? `--chip-weight: ${weight}` : undefined}>
  <span class:list={['point', `point--${point}`]} aria-hidden="true"></span>
  <span class="chip__text"><slot /></span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    padding: 6px var(--space-12);
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.3);
    /* Figma GLASS 4, approximated */
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: 6px 8px 19.7px -6px rgb(66 66 66 / 0.16);
    color: var(--color-black);
    white-space: nowrap;
  }

  .point {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 100px;
  }
  .point--orange {
    background: var(--color-brand);
    box-shadow: 0 0 6.4px var(--color-brand);
  }
  .point--green {
    background: var(--color-green);
    box-shadow: 0 0 6.4px var(--color-green-bright);
  }

  .chip--sm .chip__text {
    font: 500 12px/16px var(--font-sans);
    letter-spacing: -0.02em;
  }

  .chip--md .chip__text {
    font: var(--chip-weight, 550) 14px/20px var(--font-sans);
    letter-spacing: -0.02em;
  }

  /* Glass surface (src/scripts/glass-surface.ts, Chromium): the backdrop is bent by an
     SVG filter; the edge is drawn by inset shadows instead of the stroke */
  .chip.glass--svg {
    background: hsl(0 0% 100% / 0.14);
    outline: none;
    box-shadow:
      0 0 2px 1px color-mix(in oklch, black, transparent 85%) inset,
      0 0 10px 4px color-mix(in oklch, black, transparent 90%) inset,
      0 4px 16px rgb(17 17 26 / 0.05) inset,
      0 8px 24px rgb(17 17 26 / 0.05) inset,
      0 16px 56px rgb(17 17 26 / 0.05) inset,
      6px 8px 19.7px -6px rgb(66 66 66 / 0.16);
  }
</style>
<script>
  import { initGlass } from "../scripts/glass-surface";
  initGlass();
</script>

