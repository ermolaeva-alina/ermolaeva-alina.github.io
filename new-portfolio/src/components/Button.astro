---
// Figma: "Btn" — Color=Orange|black, Icon only=Yes|No, Size=56|44
// Renders an <a> when href is given, otherwise a <button>.
interface Props {
  href?: string;
  icon?: string; // 20px icon image before the label
  color?: 'orange' | 'black';
  size?: 56 | 44;
  iconOnly?: boolean;
  label?: string; // accessible name for icon-only buttons
  class?: string;
  style?: string;
  [attr: string]: unknown;
}
const { href, icon, color = 'orange', size = 56, iconOnly = false, label, class: className, style, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${color}`, `btn--${size}`, { 'btn--icon': iconOnly }, className]}
  href={href}
  type={href ? undefined : 'button'}
  aria-label={label}
  style={style}
  {...rest}
>
  {icon && <img src={icon} width="20" height="20" alt="" />}
  <slot name="icon" />
  {!iconOnly && <span class="btn__text"><slot /></span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    border-radius: var(--radius-s);
    color: var(--color-white);
    white-space: nowrap;
  }

  .btn--56 {
    height: 56px;
    padding: var(--space-16) var(--space-24);
  }

  .btn--44 {
    height: 44px;
    padding: var(--space-16);
    border-radius: 10px; /* Figma: Size=44 */
  }

  .btn--icon {
    width: 44px;
    padding: 0;
  }

  .btn--orange {
    background: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand-dark), var(--shadow-orange);
  }

  .btn--black {
    background: var(--color-black-dark);
    box-shadow:
      inset 0 -2px 9px rgb(255 255 255 / 0.46),
      inset 0 2px 0 rgb(255 255 255 / 0.28),
      var(--shadow-dark);
  }

  .btn__text {
    padding: 0 2px;
    font: 500 16px/20px var(--font-sans); /* New/Label 16 */
    letter-spacing: -0.02em;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-brand-dark);
    outline-offset: 2px;
  }
</style>
