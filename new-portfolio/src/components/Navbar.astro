---
// Figma: "Navbar Container" 553:618207
// Floating glass pill, centered at the top. Items have one fixed width, so the
// active font (FK Raster) doesn't shift the layout. On the home page the active
// item follows the section you are looking at. On hover the label
// under the pointer grows, with a little spring.
const items = [
  { label: 'Home', href: '/' },
  { label: 'Case studies', href: '/#case-studies' },
  { label: 'About', href: '/#about' },
  { label: 'Contacts', href: '/#contacts' },
];
const ITEM_WIDTH = 106;
const current = Astro.url.pathname;
---

<nav class="navbar" data-glass="nav" aria-label="Main">
  <ul class="list">
    {items.map((item) => {
      const active = item.href === current;
      return (
        <li>
          <a
            class:list={['item', { active }]}
            href={item.href}
            style={`width: ${ITEM_WIDTH}px`}
            aria-current={active ? 'page' : undefined}
          >
            <span class="label">
              <span class="face face--sans">{item.label}</span>
              <span class="face face--raster" aria-hidden="true">{item.label}</span>
            </span>
            <span class="dot" aria-hidden="true" />
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 22px;
    left: 50%;
    translate: -50% 0;
    z-index: 100;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.44);
    /* Figma GLASS effect, approximated */
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    outline: 1px solid var(--color-border); /* stroke OUTSIDE */
    box-shadow: 0 10px 13.8px -7px rgb(213 213 213 / 0.25);
  }

  .list {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: var(--space-8) var(--space-16);
    border-radius: 10px; /* Figma: nav item */
    font: 500 14px/normal var(--font-sans);
    letter-spacing: -0.04em;
    color: var(--color-gray);
    white-space: nowrap;
    transition: color var(--duration-hover) var(--ease-out);
  }

  /* Both fonts are stacked in one cell; becoming active cross-fades
     Inter Tight out and FK Raster in, with a short blur between them */
  .label {
    display: grid;
    justify-items: center;
    transform-origin: center;
  }
  .face {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s var(--ease-out),
      filter 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .face--raster {
    font-family: var(--font-raster-rounded);
    font-weight: 400;
    opacity: 0;
    filter: blur(3px);
    transform: translateY(3px);
  }
  .item.active .face--sans {
    opacity: 0;
    filter: blur(3px);
    transform: translateY(-3px);
  }
  .item.active .face--raster {
    opacity: 1;
    filter: none;
    transform: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .label {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); /* slight overshoot */
    }
    .item:hover .label {
      transform: scale(1.12); /* 14px text reads as ~16px */
    }
  }

  .item.active {
    color: var(--color-brand);
  }

  /* Glowing dot, half hidden under the bottom edge of the pill */
  .dot {
    position: absolute;
    left: 50%;
    top: 48.5px;
    translate: -50% 0;
    width: 8px;
    height: 8px;
    border-radius: 100px;
    background: var(--color-brand);
    box-shadow: 0 0 6.4px var(--color-brand);
    /* cut at the pill's bottom edge (nav 56px − 4px padding − 48.5px = 3.5px visible) */
    clip-path: inset(-10px -10px 4.5px -10px);
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.3s var(--ease-out);
  }

  .item.active .dot {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .face,
    .dot {
      transition: none;
    }
  }

  .item:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }

</style>
<script>
  import { initGlass } from '../scripts/glass-surface';
  initGlass();

  // Scroll spy (home page): the item of the section that holds the upper third of
  // the screen is active; above the first section it is Home.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.navbar .item')];
  const spied = links
    .map((a) => ({ a, section: a.hash ? document.getElementById(a.hash.slice(1)) : null }))
    .filter((x) => x.section);
  const home = links.find((a) => new URL(a.href).pathname === location.pathname && !a.hash);
  if (spied.length && home) {
    const setActive = (el: HTMLAnchorElement) => {
      for (const a of links) {
        const on = a === el;
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', a === home ? 'page' : 'location');
        else a.removeAttribute('aria-current');
      }
    };
    let queued = false;
    const update = () => {
      queued = false;
      const line = innerHeight / 3;
      let current = home;
      for (const { a, section } of spied) {
        // A pinned (sticky) section — the footer under the page plate — starts where
        // the element before it ends
        const prev = section!.previousElementSibling;
        const top = getComputedStyle(section!).position === 'sticky' && prev
          ? prev.getBoundingClientRect().bottom
          : section!.getBoundingClientRect().top;
        if (top <= line) current = a;
      }
      // the last section may be too short to reach the line: count the page bottom too
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = spied[spied.length - 1].a;
      if (!current.classList.contains('active')) setActive(current);
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

