---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Alina — Product Designer',
  description = 'A Product Designer working from system architecture through to business outcomes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
    <script is:inline>
      // Pixel intro (src/scripts/pixel-intro.ts): hide the grids before first paint.
      // Falls back to showing everything if the script has not started in 3s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('pixel-intro');
        setTimeout(() => { if (!window.__pixelIntroReady) document.documentElement.classList.remove('pixel-intro'); }, 3000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
