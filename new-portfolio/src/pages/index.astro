---
// Figma: home page "Container" 553:660034 → "Main" 553:617753 (vertical, gap 56, bottom padding 56)
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Top from '../components/Top.astro';
import Widgets from '../components/Widgets.astro';
import CaseStudies from '../components/CaseStudies.astro';
import MyStory from '../components/MyStory.astro';
import Contacts from '../components/Contacts.astro';
---

<Base>
  <Navbar />
  <main class="page">
    <Top />
    <Widgets />
    <CaseStudies />
    <MyStory />
  </main>
  <Contacts />
</Base>

<script>
  import { initPixelIntro, initDotReplay } from '../scripts/pixel-intro';
  initPixelIntro();
  initDotReplay();
</script>

<style>
  /* The page is a plate over the footer: rounded bottom, stroke and shadow from Figma
     "Main" (drop-shadow/xs). Scrolling past it reveals
     Contacts, which stays pinned underneath (see Contacts.astro). */
  .page {
    position: relative;
    z-index: 1;
    border-radius: 0 0 32px 32px; /* Figma: Main bottom corners */
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.1), /* Figma: Main stroke, black 10% */
      0 1px 2px rgb(54 54 48 / 0.05); /* Figma: effects/drop-shadow/xs */
    background: var(--color-bg); /* Figma: Main fill #f2f3f3 over the Container gradient */
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding-bottom: var(--space-56);
  }
</style>
